{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub Deploy Management",
  "version": "0.1.0",
  "identifier": "com.muhajirdit.gh-deploy-management",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitHub Deploy Management",
        "width": 360,
        "height": 608,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5MTY1RDc0MUFGNzg2N0QKUldSOWh2Y2FkRjBXR1duVSs2amhBZzBhTDJOSmRJbUFmMVdKZEExbjk1WS9MK3lRUnQyNnVmZHYK",
      "endpoints": [
        "https://github.com/hajir-muhajir/gh-deploy-management/releases/latest/download/latest.json"
      ]
    }
  }
}
